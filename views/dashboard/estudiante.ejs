<!DOCTYPE html>

<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Dashboard del estudiante — Gimnasio Universitario UNAM">
  <title>
    <%= usuario.nombres %> — Gimnasio UNAM
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --accent: #4f46e5;
      --accent-dark: #3730a3;
      --accent-light: #eef2ff;
      --bg: #f1f5f9;
      --card: #ffffff;
      --nav: #0f172a;
      --text: #1e293b;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.07), 0 1px 2px rgba(0, 0, 0, 0.05);
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.08), 0 1px 4px rgba(0, 0, 0, 0.05);
      --radius: 0.875rem;
      --new-badge: #ecfdf5;
      --new-text: #10b981;
      --new-border: #a7f3d0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── Navbar ────────────────────────────────────────── */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--nav);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 64px;
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 700;
      font-size: 1rem;
      color: #fff;
      text-decoration: none;
    }

    .nav-brand span {
      font-size: 1.4rem;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .nav-user {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .nav-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), #7c3aed);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .nav-name {
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.875rem;
      font-weight: 500;
    }

    .nav-role-badge {
      background: rgba(79, 70, 229, 0.25);
      border: 1px solid rgba(79, 70, 229, 0.45);
      color: #a5b4fc;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
    }

    .btn-logout {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 1rem;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      border-radius: 0.5rem;
      font-family: 'Inter', sans-serif;
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.2s, border-color 0.2s;
      cursor: pointer;
    }

    .btn-logout:hover {
      background: rgba(239, 68, 68, 0.22);
      border-color: rgba(239, 68, 68, 0.5);
    }

    /* ── Contenido principal ───────────────────────────── */
    .main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem 3rem;
    }

    /* ── Hero / Saludo ─────────────────────────────────── */
    .hero {
      background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
      border-radius: var(--radius);
      padding: 2rem 2.25rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 8px 32px rgba(79, 70, 229, 0.3);
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: '';
      position: absolute;
      right: -40px;
      top: -40px;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.06);
    }

    .hero-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      border: 2px solid rgba(255, 255, 255, 0.35);
      color: #fff;
      font-size: 1.6rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      backdrop-filter: blur(4px);
    }

    .hero-text h1 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.02em;
    }

    .hero-text p {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.75);
      margin-top: 0.25rem;
    }

    /* ── Layout: 2 columnas ────────────────────────────── */
    .layout {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    @media (max-width: 768px) {
      .layout {
        grid-template-columns: 1fr;
      }
    }

    /* ── Tarjeta genérica ──────────────────────────────── */
    .card {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .card-header {
      padding: 1.1rem 1.4rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .card-header h2 {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: 0.01em;
    }

    .card-header .icon {
      font-size: 1rem;
    }

    .card-body {
      padding: 1.25rem 1.4rem;
    }

    /* ── Perfil ────────────────────────────────────────── */
    .profile-item {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--border);
    }

    .profile-item:last-child {
      border-bottom: none;
    }

    .profile-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .profile-value {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text);
      word-break: break-word;
    }

    .badge-activo {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #15803d;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
    }

    .badge-activo::before {
      content: '●';
      font-size: 0.5rem;
    }

    /* ── Módulos ───────────────────────────────────────── */
    .section-title {
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    .modules-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
    }

    .module-card {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 1.4rem 1.1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      opacity: 0.6;
      cursor: not-allowed;
      position: relative;
      transition: opacity 0.2s;
    }

    .module-card.disponible {
      opacity: 1;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
    }

    .module-card.disponible:hover {
      border-color: var(--accent);
      box-shadow: 0 4px 20px rgba(79, 70, 229, 0.15);
      transform: translateY(-2px);
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .module-icon {
      font-size: 1.75rem;
    }

    .module-name {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text);
    }

    .module-desc {
      font-size: 0.775rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .module-badge {
      display: inline-block;
      margin-top: auto;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .badge-soon {
      background: #fef9c3;
      color: #854d0e;
      border: 1px solid #fde68a;
    }

    .badge-ready {
      background: var(--accent-light);
      color: var(--accent);
      border: 1px solid #c7d2fe;
    }
  </style>
</head>

<body>

  <!-- ── Navbar ─────────────────────────────────────────── -->
  <nav class="navbar" role="navigation" aria-label="Navegación principal">
    <a href="/dashboard/estudiante" class="nav-brand">
      <span>🏋️</span> Gimnasio UNAM
    </a>
    <div class="nav-right">
      <div class="nav-user">
        <div class="nav-avatar" aria-hidden="true">
          <%= usuario.nombres.charAt(0).toUpperCase() %>
            <%= usuario.apellidos.charAt(0).toUpperCase() %>
        </div>
        <span class="nav-name">
          <%= usuario.nombres %>
            <%= usuario.apellidos %>
        </span>
        <span class="nav-role-badge">Estudiante</span>
      </div>
      <a href="/logout" class="btn-logout" id="btnLogout">
        <span>⏻</span> Salir
      </a>
    </div>
  </nav>

  <main class="main">

    <!-- ── Hero ───────────────────────────────────────────── -->
    <section class="hero" aria-label="Bienvenida">
      <div class="hero-avatar" aria-hidden="true">
        <%= usuario.nombres.charAt(0).toUpperCase() %>
          <%= usuario.apellidos.charAt(0).toUpperCase() %>
      </div>
      <div class="hero-text">
        <h1>
          <%= saludo %>, <%= usuario.nombres %>!
        </h1>
        <p>Bienvenido/a a tu espacio en el Gimnasio Universitario UNAM</p>
      </div>
    </section>

    <!-- ── Layout principal ──────────────────────────────── -->
    <div class="layout">

      <!-- ── Tarjeta de perfil ──── -->
      <aside>
        <div class="card">
          <div class="card-header">
            <span class="icon">👤</span>
            <h2>Mi Perfil</h2>
          </div>
          <div class="card-body">

            <div class="profile-item">
              <span class="profile-label">Código Universitario</span>
              <span class="profile-value">
                <%= usuario.codigo %>
              </span>
            </div>

            <div class="profile-item">
              <span class="profile-label">Nombre Completo</span>
              <span class="profile-value">
                <%= usuario.nombres %>
                  <%= usuario.apellidos %>
              </span>
            </div>

            <div class="profile-item">
              <span class="profile-label">Correo Electrónico</span>
              <span class="profile-value">
                <%= usuario.correo %>
              </span>
            </div>

            <div class="profile-item">
              <span class="profile-label">Rol</span>
              <span class="profile-value">Estudiante</span>
            </div>

            <div class="profile-item">
              <span class="profile-label">Estado de Cuenta</span>
              <span class="profile-value">
                <span class="badge-activo">
                  <%= usuario.estado %>
                </span>
              </span>
            </div>

            <div class="profile-item">
              <span class="profile-label">Miembro desde</span>
              <span class="profile-value">
                <%= new Date(usuario.fecha_registro).toLocaleDateString('es-MX', { year: 'numeric' , month: 'long' ,
                  day: 'numeric' }) %>
              </span>
            </div>

          </div>
        </div>
      </aside>

      <!-- ── Columna derecha: Perfil Físico + Módulos ──────────────── -->
      <div class="right-col" style="display: flex; flex-direction: column; gap: 1.5rem;">

        <!-- ── Perfil Físico ──────────────────────────────────── -->
        <section aria-label="Perfil Físico">
          <% if (!perfilFisico) { %>
            <div class="card" style="border: 1.5px solid #fde047; background: #fefce8; padding: 1.5rem;">
              <h2
                style="color: #854d0e; font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
                <span>⚠️</span> Completa tu Perfil Físico
              </h2>
              <p style="color: #713f12; font-size: 0.9rem; margin-bottom: 1.25rem; line-height: 1.5;">
                Para poder asignarte rutinas personalizadas, registrar tus ejercicios y medir tu progreso, necesitamos
                conocer tus datos físicos y objetivos de entrenamiento.
              </p>
              <a href="/estudiante/perfil"
                style="display: inline-block; padding: 0.6rem 1.25rem; background: var(--accent); color: #fff; font-weight: 600; font-size: 0.875rem; border-radius: 0.5rem; text-decoration: none; transition: transform 0.15s, box-shadow 0.15s;">
                Completar Perfil Físico
              </a>
            </div>
            <% } else { %>
              <div class="card">
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                  <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <span class="icon">💪</span>
                    <h2>Perfil Físico y Objetivos</h2>
                  </div>
                  <a href="/estudiante/perfil"
                    style="font-size: 0.8rem; color: var(--accent); font-weight: 600; text-decoration: none; padding: 0.3rem 0.6rem; border-radius: 0.3rem; background: var(--accent-light);">
                    Editar Perfil
                  </a>
                </div>
                <div class="card-body"
                  style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1.25rem;">
                  <div>
                    <span class="profile-label">Peso Actual</span>
                    <span class="profile-value"
                      style="display: block; font-size: 1.15rem; font-weight: 600; margin-top: 0.25rem; color: var(--accent);">
                      <%= perfilFisico.peso %> kg
                    </span>
                  </div>
                  <div>
                    <span class="profile-label">Altura</span>
                    <span class="profile-value"
                      style="display: block; font-size: 1.15rem; font-weight: 600; margin-top: 0.25rem; color: var(--accent);">
                      <%= perfilFisico.altura %> m
                    </span>
                  </div>
                  <div>
                    <span class="profile-label">Índice Masa Corp.</span>
                    <span class="profile-value"
                      style="display: block; font-size: 1.15rem; font-weight: 600; margin-top: 0.25rem; color: var(--text);">
                      <%= (perfilFisico.peso / (perfilFisico.altura * perfilFisico.altura)).toFixed(1) %>
                    </span>
                  </div>
                  <div style="grid-column: 1 / -1; margin-top: 0.5rem;">
                    <span class="profile-label">Objetivo Principal</span>
                    <span class="profile-value" style="display: block; font-size: 1.05rem; margin-top: 0.25rem;">
                      <%= perfilFisico.objetivo_principal %>
                    </span>
                  </div>
                  <div style="grid-column: 1 / -1;">
                    <span class="profile-label">Días Disponibles</span>
                    <span class="profile-value"
                      style="display: block; font-size: 0.95rem; margin-top: 0.25rem; line-height: 1.4;">
                      <%= perfilFisico.dias_disponibles %>
                    </span>
                  </div>
                </div>
              </div>
              <% } %>
        </section>

        <!-- ── Módulos ──────────────── -->
        <section aria-label="Módulos disponibles">
          <p class="section-title">Módulos</p>
          <div class="modules-grid">

            <a href="/estudiante/rutina" class="module-card disponible" style="text-decoration: none;">
              <span class="module-icon">📋</span>
              <span class="module-name">Mi Rutina</span>
              <span class="module-desc">Consulta el plan de entrenamiento que te asignó tu docente.</span>
              <span class="module-badge badge-ready">Disponible</span>
            </a>

            <a href="/estudiante/entrenamiento" class="module-card disponible" style="text-decoration: none;">
              <span class="module-icon">💪</span>
              <span class="module-name">Entrenamiento</span>
              <span class="module-desc">Inicia tu sesión y registra los ejercicios realizados hoy.</span>
              <span class="module-badge badge-ready">Disponible</span>
            </a>

            <a href="/estudiante/historial" class="module-card disponible" style="text-decoration: none;">
              <span class="module-icon">📅</span>
              <span class="module-name">Historial</span>
              <span class="module-desc">Revisa tus sesiones pasadas y el detalle de cada entrenamiento.</span>
              <span class="module-badge badge-ready">Disponible</span>
            </a>

            <a href="/estudiante/progreso" class="module-card disponible" style="text-decoration: none;">
              <span class="module-icon">📈</span>
              <span class="module-name">Progreso</span>
              <span class="module-desc">Visualiza tus estadísticas generales y evolución con gráficas
                interactivas.</span>
              <span class="module-badge badge-ready">Disponible</span>
            </a>

            <a href="/estudiante/asistencia" class="module-card disponible" style="text-decoration: none;">
              <span class="module-icon">📍</span>
              <span class="module-name">Asistencia</span>
              <span class="module-desc">Registra tu entrada y salida del gimnasio y revisa tu historial.</span>
              <span class="module-badge badge-ready">Disponible</span>
            </a>

            <a href="/estudiante/recomendaciones" class="module-card disponible" style="text-decoration: none;">
              <span class="module-icon">✉️</span>
              <span class="module-name">Mis Recomendaciones</span>
              <span class="module-desc">Consejos y mensajes enviados por tus docentes.</span>
              <% if (conteoRecomendaciones> 0) { %>
                <span class="module-badge badge-ready"
                  style="background: var(--new-badge); color: var(--new-text); border-color: var(--new-border);">
                  <%= conteoRecomendaciones %> en total
                </span>
                <% } else { %>
                  <span class="module-badge badge-ready">Disponible</span>
                  <% } %>
            </a>

          </div>
        </section>

      </div> <!-- Cerrar right-col -->
    </div>

  </main>

</body>

</html>