<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Gestión de Rutinas - Estudiantes Registrados">
  <title>Asignar Rutinas — Gimnasio UNAM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      var(--accent):       #7c3aed;
      --accent-dark:  #5b21b6;
      --accent-light: #f5f3ff;
      --bg:           #f1f5f9;
      --card:         #ffffff;
      --nav:          #0f172a;
      --text:         #1e293b;
      --text-muted:   #64748b;
      --border:       #e2e8f0;
      --shadow-sm:    0 1px 3px rgba(0,0,0,0.07), 0 1px 2px rgba(0,0,0,0.05);
      --shadow:       0 4px 16px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.05);
      --radius:       0.875rem;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── Navbar ────────────────────────────────────────── */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--nav);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 64px;
      box-shadow: 0 1px 0 rgba(255,255,255,0.06);
    }
    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 700;
      font-size: 1rem;
      color: #fff;
      text-decoration: none;
    }
    .nav-brand span { font-size: 1.4rem; }
    .nav-right { display: flex; align-items: center; gap: 1rem; }
    .nav-user  { display: flex; align-items: center; gap: 0.6rem; }
    .nav-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, #7c3aed, #4f46e5);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .nav-name {
      color: rgba(255,255,255,0.9);
      font-size: 0.875rem;
      font-weight: 500;
    }
    .nav-role-badge {
      background: rgba(124,58,237,0.25);
      border: 1px solid rgba(124,58,237,0.45);
      color: #c4b5fd;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
    }
    .btn-logout {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 1rem;
      background: rgba(239,68,68,0.12);
      border: 1px solid rgba(239,68,68,0.3);
      color: #fca5a5;
      border-radius: 0.5rem;
      font-family: 'Inter', sans-serif;
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-logout:hover {
      background: rgba(239,68,68,0.22);
      border-color: rgba(239,68,68,0.5);
    }

    /* ── Contenido principal ───────────────────────────── */
    .main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem 3rem;
    }

    .header-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    
    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1rem;
      background: #fff;
      border: 1px solid var(--border);
      color: var(--text);
      font-weight: 500;
      font-size: 0.875rem;
      border-radius: 0.5rem;
      text-decoration: none;
      transition: all 0.2s;
      box-shadow: var(--shadow-sm);
    }
    .btn-back:hover {
      background: var(--bg);
      border-color: #cbd5e1;
    }

    /* ── Tarjetas y Tablas ──────────────────────────────────────── */
    .card {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    
    .table-container {
      width: 100%;
      overflow-x: auto;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    
    th {
      background: #f8fafc;
      padding: 1rem 1.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
    }
    
    td {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }
    
    tr:last-child td {
      border-bottom: none;
    }
    
    tr:hover td {
      background-color: #f8fafc;
    }

    .cell-codigo {
      font-family: monospace;
      font-size: 0.9rem;
      color: var(--text-muted);
      background: var(--bg);
      padding: 0.2rem 0.5rem;
      border-radius: 0.25rem;
      border: 1px solid var(--border);
    }

    .cell-nombre {
      font-weight: 600;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .student-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #e2e8f0;
      color: #475569;
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cell-objetivo {
      font-size: 0.875rem;
      color: #475569;
    }

    .cell-dias {
      font-size: 0.8125rem;
      color: var(--text-muted);
      line-height: 1.4;
      max-width: 200px;
    }
    
    .btn-crear {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.8rem;
      background: #7c3aed;
      color: #fff;
      font-weight: 600;
      font-size: 0.8125rem;
      border-radius: 0.4rem;
      text-decoration: none;
      transition: background 0.2s;
    }
    .btn-crear:hover {
      background: #6d28d9;
    }

    .empty-state {
      padding: 4rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .empty-state-icon {
      font-size: 3rem;
      opacity: 0.5;
    }
    .empty-state h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--text);
    }
    .empty-state p {
      font-size: 0.9rem;
      color: var(--text-muted);
      max-width: 400px;
    }
  </style>
</head>
<body>

  <!-- ── Navbar ─────────────────────────────────────────── -->
  <nav class="navbar" role="navigation" aria-label="Navegación principal">
    <a href="/dashboard/docente" class="nav-brand">
      <span>🏋️</span> Gimnasio UNAM
    </a>
    <div class="nav-right">
      <div class="nav-user">
        <div class="nav-avatar" aria-hidden="true">
          <%= usuario.nombres.charAt(0).toUpperCase() %><%= usuario.apellidos.charAt(0).toUpperCase() %>
        </div>
        <span class="nav-name"><%= usuario.nombres %> <%= usuario.apellidos %></span>
        <span class="nav-role-badge">Docente</span>
      </div>
      <a href="/logout" class="btn-logout" id="btnLogout">
        <span>⏻</span> Salir
      </a>
    </div>
  </nav>

  <main class="main">

    <div class="header-actions">
      <h1 class="page-title">📋 Estudiantes Registrados</h1>
      <a href="/dashboard/docente" class="btn-back"><span>←</span> Volver al Panel</a>
    </div>

    <div class="card">
      <% if (estudiantes && estudiantes.length > 0) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Estudiante</th>
                <th>Código</th>
                <th>Objetivo Principal</th>
                <th>Días Disponibles</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% estudiantes.forEach(est => { %>
                <tr>
                  <td>
                    <div class="cell-nombre">
                      <div class="student-avatar" aria-hidden="true">
                        <%= est.nombres.charAt(0).toUpperCase() %><%= est.apellidos.charAt(0).toUpperCase() %>
                      </div>
                      <%= est.nombres %> <%= est.apellidos %>
                    </div>
                  </td>
                  <td>
                    <span class="cell-codigo"><%= est.codigo %></span>
                  </td>
                  <td>
                    <span class="cell-objetivo"><%= est.objetivo_principal %></span>
                  </td>
                  <td>
                    <span class="cell-dias"><%= est.dias_disponibles %></span>
                  </td>
                  <td>
                    <a href="/docente/rutinas/crear/<%= est.id_estudiante %>" class="btn-crear">
                      <span>➕</span> Crear rutina
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">👥</div>
          <h3>No hay estudiantes disponibles</h3>
          <p>Actualmente no hay estudiantes que hayan completado su perfil físico. Solo los estudiantes con perfil completo pueden recibir rutinas.</p>
        </div>
      <% } %>
    </div>

  </main>

</body>
</html>
