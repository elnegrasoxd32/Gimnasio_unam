<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Asistencias — Gimnasio UNAM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent:       #4f46e5;
      --bg:           #f1f5f9;
      --card:         #ffffff;
      --nav:          #0f172a;
      --text:         #1e293b;
      --text-muted:   #64748b;
      --border:       #e2e8f0;
      --radius:       0.875rem;
      --shadow:       0 4px 16px rgba(0,0,0,0.08);
    }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .navbar { background: var(--nav); display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 64px; color: #fff; }
    .main { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
    .header-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .page-title { font-size: 1.5rem; font-weight: 700; }
    .btn-back { display: inline-flex; padding: 0.5rem 1rem; background: #fff; border: 1px solid var(--border); border-radius: 0.5rem; text-decoration: none; color: var(--text); font-weight: 500; }
    
    .card { background: var(--card); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); margin-bottom: 2rem; }
    
    .filter-bar { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end; margin-bottom: 1.5rem; }
    .filter-group { display: flex; flex-direction: column; gap: 0.3rem; }
    .filter-group label { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; }
    .filter-group input { padding: 0.6rem; border: 1px solid var(--border); border-radius: 0.5rem; font-family: inherit; font-size: 0.95rem; min-width: 200px; }
    .btn-filter { padding: 0.6rem 1.25rem; background: var(--accent); color: #fff; border: none; border-radius: 0.5rem; font-weight: 600; cursor: pointer; }
    .btn-clear { padding: 0.6rem 1.25rem; background: #f1f5f9; color: var(--text); border: 1px solid var(--border); border-radius: 0.5rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }

    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { text-align: left; padding: 1rem; border-bottom: 1px solid var(--border); }
    th { background: #f8fafc; font-weight: 600; color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; }
    td { font-size: 0.95rem; }
  </style>
</head>
<body>
  <nav class="navbar">
    <div style="font-weight: 700;">🏋️ Gimnasio UNAM</div>
    <div><%= usuario.nombres %> (Docente)</div>
  </nav>

  <main class="main">
    <div class="header-actions">
      <h1 class="page-title">📍 Registro de Asistencias</h1>
      <a href="/dashboard/docente" class="btn-back">← Volver al Dashboard</a>
    </div>

    <div class="card">
      <form class="filter-bar" method="GET" action="/docente/asistencias">
        <div class="filter-group">
          <label>Buscar por Estudiante</label>
          <input type="text" name="filtroEstudiante" placeholder="Nombre o Código" value="<%= filtroEstudiante %>">
        </div>
        <div class="filter-group">
          <label>Fecha</label>
          <input type="date" name="filtroFecha" value="<%= filtroFecha %>">
        </div>
        <button type="submit" class="btn-filter">Filtrar</button>
        <a href="/docente/asistencias" class="btn-clear">Limpiar</a>
      </form>

      <% if (historial && historial.length > 0) { %>
        <div style="overflow-x: auto;">
          <table>
            <thead>
              <tr>
                <th>Código</th>
                <th>Estudiante</th>
                <th>Fecha</th>
                <th>Ingreso</th>
                <th>Salida</th>
                <th>Duración</th>
                <th>Método</th>
              </tr>
            </thead>
            <tbody>
              <% historial.forEach(a => { %>
                <tr>
                  <td style="font-weight: 600; color: var(--accent);"><%= a.codigo %></td>
                  <td><%= a.nombres %> <%= a.apellidos %></td>
                  <td><%= new Date(a.fecha_ingreso).toLocaleDateString('es-MX') %></td>
                  <td><%= new Date(a.fecha_ingreso).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) %></td>
                  <td>
                    <% if (a.fecha_salida) { %>
                      <%= new Date(a.fecha_salida).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) %>
                    <% } else { %>
                      <span style="color: var(--accent); font-weight: 600;">En curso</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (a.fecha_salida) { %>
                      <%= Math.round(a.duracion_minutos) %> min
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td><%= a.metodo %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: var(--text-muted);">No se encontraron registros de asistencia para estos filtros.</p>
      <% } %>
    </div>
  </main>
</body>
</html>
