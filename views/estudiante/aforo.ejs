<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aforo del Gimnasio — Gimnasio UNAM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent:       #4f46e5;
      --bg:           #f1f5f9;
      --card:         #ffffff;
      --nav:          #0f172a;
      --text:         #1e293b;
      --text-muted:   #64748b;
      --border:       #e2e8f0;
      --radius:       0.875rem;
      --shadow:       0 4px 16px rgba(0,0,0,0.08);
    }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .navbar { background: var(--nav); display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 64px; color: #fff; }
    .main { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }
    .header-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .page-title { font-size: 1.5rem; font-weight: 700; }
    .btn-back { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.5rem 1rem; background: #fff; border: 1px solid var(--border); border-radius: 0.5rem; text-decoration: none; color: var(--text); font-weight: 500; font-size: 0.9rem; transition: border-color 0.2s; }
    .btn-back:hover { border-color: var(--accent); }

    .card { background: var(--card); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow); margin-bottom: 1.5rem; text-align: center; }
    
    /* ── Aforo Widget ─────────────────────────────────────── */
    .aforo-circle {
      width: 200px; height: 200px; border-radius: 50%; margin: 0 auto 1.5rem auto;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      border: 8px solid var(--border); position: relative; transition: border-color 0.4s;
    }
    .aforo-circle.success { border-color: #10b981; background: #ecfdf5; }
    .aforo-circle.warning { border-color: #f59e0b; background: #fffbeb; }
    .aforo-circle.danger  { border-color: #ef4444; background: #fef2f2; }
    
    .aforo-number { font-size: 4rem; font-weight: 700; color: var(--text); line-height: 1; }
    .aforo-label { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; margin-top: 0.5rem; }
    
    .aforo-info { display: flex; justify-content: center; gap: 2rem; margin-top: 1.5rem; flex-wrap: wrap; }
    .info-box { background: #f8fafc; padding: 1rem; border-radius: 0.5rem; border: 1px solid var(--border); min-width: 150px; }
    .info-label { font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; }
    .info-value { font-size: 1.25rem; font-weight: 700; color: var(--text); margin-top: 0.25rem; }

    .last-update { font-size: 0.8rem; color: var(--text-muted); margin-top: 2rem; display: flex; align-items: center; justify-content: center; gap: 0.4rem; }
    
    .badge { display: inline-block; padding: 0.3rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
    .badge-success { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
    .badge-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .badge-danger  { background: #fee2e2; color: #b91c1c; border: 1px solid #f87171; }
  </style>
</head>
<body>
  <nav class="navbar">
    <div style="font-weight: 700;">🏋️ Gimnasio UNAM</div>
    <div><%= usuario.nombres %> (Estudiante)</div>
  </nav>

  <main class="main">
    <div class="header-actions">
      <h1 class="page-title">📊 Aforo en Tiempo Real</h1>
      <a href="/dashboard/estudiante" class="btn-back">← Volver al Dashboard</a>
    </div>

    <div class="card">
      <h2 style="font-size: 1.1rem; color: var(--text-muted); margin-bottom: 2rem;">Ocupación actual del gimnasio</h2>
      
      <div id="aforoCircle" class="aforo-circle <%= aforo.color %>">
        <div class="aforo-number" id="presentesText"><%= presentes %></div>
        <div class="aforo-label">Personas</div>
      </div>
      
      <div style="margin-bottom: 1rem;">
        <span id="nivelBadge" class="badge badge-<%= aforo.color %>">Nivel <%= aforo.nivel %></span>
      </div>

      <div class="aforo-info">
        <div class="info-box">
          <div class="info-label">Capacidad Máxima</div>
          <div class="info-value"><%= capacidad_maxima %></div>
        </div>
        <div class="info-box">
          <div class="info-label">Ocupación</div>
          <div class="info-value" id="porcentajeText"><%= aforo.porcentaje %>%</div>
        </div>
      </div>
      
      <div class="last-update">
        <span style="font-size: 1rem;">🔄</span> 
        Actualizado automáticamente: <span id="updateTime"></span>
      </div>
    </div>
  </main>

  <script>
    function updateTimeDisplay() {
      const now = new Date();
      document.getElementById('updateTime').innerText = now.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    updateTimeDisplay();

    // Actualización automática cada 15 segundos
    setInterval(async () => {
      try {
        const res = await fetch('/estudiante/api/aforo');
        if (res.ok) {
          const data = await res.json();
          document.getElementById('presentesText').innerText = data.presentes;
          document.getElementById('porcentajeText').innerText = data.aforo.porcentaje + '%';
          
          const circle = document.getElementById('aforoCircle');
          circle.className = 'aforo-circle ' + data.aforo.color;
          
          const badge = document.getElementById('nivelBadge');
          badge.className = 'badge badge-' + data.aforo.color;
          badge.innerText = 'Nivel ' + data.aforo.nivel;
          
          updateTimeDisplay();
        }
      } catch(e) {
        console.error('Error al actualizar el aforo', e);
      }
    }, 15000);
  </script>
</body>
</html>
