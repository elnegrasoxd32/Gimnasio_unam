<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Asistencia — Gimnasio UNAM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent:       #4f46e5;
      --accent-dark:  #3730a3;
      --bg:           #f1f5f9;
      --card:         #ffffff;
      --nav:          #0f172a;
      --text:         #1e293b;
      --text-muted:   #64748b;
      --border:       #e2e8f0;
      --radius:       0.875rem;
      --shadow:       0 4px 16px rgba(0,0,0,0.08);
      --success:      #10b981;
      --danger:       #ef4444;
    }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .navbar { background: var(--nav); display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 64px; color: #fff; }
    .main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
    .header-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .page-title { font-size: 1.5rem; font-weight: 700; }
    .btn-back { display: inline-flex; padding: 0.5rem 1rem; background: #fff; border: 1px solid var(--border); border-radius: 0.5rem; text-decoration: none; color: var(--text); font-weight: 500; }
    
    .alert { padding: 1rem; border-radius: 0.5rem; margin-bottom: 1.5rem; font-weight: 500; }
    .alert-error { background: #fee2e2; border: 1px solid #f87171; color: #b91c1c; }
    .alert-success { background: #d1fae5; border: 1px solid #34d399; color: #065f46; }

    .card { background: var(--card); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); margin-bottom: 2rem; }
    .action-container { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 2rem 0; }
    
    .btn { padding: 1rem 2rem; font-size: 1.1rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; color: #fff; transition: background 0.2s; }
    .btn-ingreso { background: var(--accent); }
    .btn-ingreso:hover { background: var(--accent-dark); }
    .btn-salida { background: var(--danger); }
    .btn-salida:hover { background: #dc2626; }

    .status-badge { padding: 0.5rem 1rem; border-radius: 999px; font-weight: 600; font-size: 0.9rem; }
    .status-active { background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; }

    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { text-align: left; padding: 1rem; border-bottom: 1px solid var(--border); }
    th { background: #f8fafc; font-weight: 600; color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; }
    td { font-size: 0.95rem; }
  </style>
</head>
<body>
  <nav class="navbar">
    <div style="font-weight: 700;">🏋️ Gimnasio UNAM</div>
    <div><%= usuario.nombres %> (Estudiante)</div>
  </nav>

  <main class="main">
    <div class="header-actions">
      <h1 class="page-title">📍 Control de Asistencia</h1>
      <a href="/dashboard/estudiante" class="btn-back">← Volver al Dashboard</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">⚠️ <%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success">✅ <%= success %></div>
    <% } %>

    <div class="card action-container">
      <% if (asistenciaActiva) { %>
        <div class="status-badge status-active">
          En curso desde: <%= new Date(asistenciaActiva.fecha_ingreso).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) %>
        </div>
        <form action="/estudiante/asistencia/salida" method="POST" style="margin-top: 1rem;">
          <button type="submit" class="btn btn-salida">Registrar Salida</button>
        </form>
      <% } else { %>
        <p style="color: var(--text-muted); margin-bottom: 0.5rem;">Actualmente no estás en el gimnasio.</p>
        <form action="/estudiante/asistencia/ingreso" method="POST">
          <button type="submit" class="btn btn-ingreso">Registrar Ingreso</button>
        </form>
      <% } %>
    </div>

    <div class="card">
      <h2 style="font-size: 1.1rem; margin-bottom: 1rem;">Historial de Asistencias</h2>
      <% if (historial && historial.length > 0) { %>
        <div style="overflow-x: auto;">
          <table>
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Hora Ingreso</th>
                <th>Hora Salida</th>
                <th>Duración</th>
                <th>Método</th>
              </tr>
            </thead>
            <tbody>
              <% historial.forEach(a => { %>
                <tr>
                  <td><%= new Date(a.fecha_ingreso).toLocaleDateString('es-MX') %></td>
                  <td><%= new Date(a.fecha_ingreso).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) %></td>
                  <td>
                    <% if (a.fecha_salida) { %>
                      <%= new Date(a.fecha_salida).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) %>
                    <% } else { %>
                      <span style="color: var(--accent); font-weight: 600;">En curso</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (a.fecha_salida) { %>
                      <%= Math.round(a.duracion_minutos) %> min
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td><%= a.metodo %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: var(--text-muted);">Aún no tienes registros de asistencia.</p>
      <% } %>
    </div>
  </main>
</body>
</html>
