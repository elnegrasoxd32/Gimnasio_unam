<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Progreso — Gimnasio UNAM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent:       #4f46e5;
      --accent-dark:  #3730a3;
      --bg:           #f1f5f9;
      --card:         #ffffff;
      --nav:          #0f172a;
      --text:         #1e293b;
      --text-muted:   #64748b;
      --border:       #e2e8f0;
      --radius:       0.875rem;
      --shadow:       0 4px 16px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.05);
    }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    
    .navbar { background: var(--nav); display: flex; align-items: center; justify-content: space-between; padding: 0 2rem; height: 64px; color: #fff; }
    
    .main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
    .header-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .page-title { font-size: 1.5rem; font-weight: 700; color: var(--text); }
    .btn-back { display: inline-flex; padding: 0.5rem 1rem; background: #fff; border: 1px solid var(--border); border-radius: 0.5rem; text-decoration: none; color: var(--text); font-weight: 500; }
    
    /* ── Summary Cards ── */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .summary-card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow);
      border-top: 4px solid var(--accent);
      display: flex;
      flex-direction: column;
    }
    .summary-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }
    .summary-value {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text);
    }

    /* ── Charts Grid ── */
    .charts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    @media (max-width: 768px) {
      .charts-grid { grid-template-columns: 1fr; }
    }
    .chart-card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow);
    }
    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .chart-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text);
    }
    .form-select {
      padding: 0.5rem;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      color: var(--text);
      outline: none;
    }
    
    .empty-state { text-align: center; padding: 4rem 2rem; background: var(--card); border-radius: var(--radius); }
    .empty-state h3 { font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--text); }
    .empty-state p { color: var(--text-muted); font-size: 1rem; }
  </style>
</head>
<body>

  <nav class="navbar">
    <div style="font-weight: 700;">🏋️ Gimnasio UNAM</div>
    <div><%= usuario.nombres %> (Estudiante)</div>
  </nav>

  <main class="main">
    <div class="header-actions">
      <h1 class="page-title">📈 Mi Progreso</h1>
      <a href="/dashboard/estudiante" class="btn-back">← Volver al Dashboard</a>
    </div>

    <% if (!resumen || resumen.total_sesiones === '0' || !resumen.total_sesiones) { %>
      <div class="empty-state">
        <div style="font-size: 3.5rem; opacity: 0.5; margin-bottom: 1rem;">📭</div>
        <h3>Aún no hay datos suficientes</h3>
        <p>Completa tus sesiones de entrenamiento para comenzar a visualizar tu progreso aquí.</p>
      </div>
    <% } else { %>
      
      <!-- Summary -->
      <div class="summary-grid">
        <div class="summary-card">
          <span class="summary-title">Entrenamientos</span>
          <span class="summary-value"><%= resumen.total_sesiones %></span>
        </div>
        <div class="summary-card">
          <span class="summary-title">Ejercicios Registrados</span>
          <span class="summary-value"><%= resumen.total_ejercicios %></span>
        </div>
        <div class="summary-card">
          <span class="summary-title">Peso Máximo (kg)</span>
          <span class="summary-value"><%= parseFloat(resumen.peso_maximo).toFixed(1) %></span>
        </div>
        <div class="summary-card">
          <span class="summary-title">Promedio de Peso (kg)</span>
          <span class="summary-value"><%= parseFloat(resumen.peso_promedio || 0).toFixed(1) %></span>
        </div>
        <div class="summary-card">
          <span class="summary-title">Ejercicio Fav.</span>
          <span class="summary-value" style="font-size: 1.1rem; line-height: 1.6;"><%= resumen.ejercicio_favorito || 'N/A' %></span>
        </div>
      </div>

      <!-- Charts -->
      <div class="charts-grid">
        
        <!-- Líneas: Evolución de Peso -->
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">Evolución de Peso</h3>
            <select id="selectEjercicio" class="form-select" onchange="cargarEvolucion()">
              <% ejercicios.forEach(ej => { %>
                <option value="<%= ej.id_ejercicio %>"><%= ej.nombre %></option>
              <% }); %>
            </select>
          </div>
          <canvas id="lineChart" style="max-height: 300px; width: 100%;"></canvas>
        </div>

        <!-- Barras: Entrenamientos por mes -->
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">Entrenamientos Realizados</h3>
          </div>
          <canvas id="barChart" style="max-height: 300px; width: 100%;"></canvas>
        </div>

      </div>
    <% } %>

  </main>

  <% if (resumen && resumen.total_sesiones !== '0' && resumen.total_sesiones) { %>
  <script>
    // Configuración general de Chart.js
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = "#64748b";

    // ── Bar Chart (Entrenamientos por mes) ──
    const mesesData = <%- JSON.stringify(entrenamientosPorMes) %>;
    const labelsMeses = mesesData.map(d => d.mes);
    const dataMeses = mesesData.map(d => parseInt(d.cantidad));

    const ctxBar = document.getElementById('barChart').getContext('2d');
    new Chart(ctxBar, {
      type: 'bar',
      data: {
        labels: labelsMeses,
        datasets: [{
          label: 'Sesiones',
          data: dataMeses,
          backgroundColor: '#4f46e5',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0 } }
        }
      }
    });

    // ── Line Chart (Evolución de Peso) ──
    let lineChart;
    const ctxLine = document.getElementById('lineChart').getContext('2d');

    async function cargarEvolucion() {
      const select = document.getElementById('selectEjercicio');
      if (!select) return;
      const id_ejercicio = select.value;
      if (!id_ejercicio) return;

      try {
        const res = await fetch('/estudiante/progreso/api/evolucion/' + id_ejercicio);
        const data = await res.json();
        
        const labelsFechas = data.map(d => d.fecha);
        const dataPesos = data.map(d => parseFloat(d.peso_maximo));

        if (lineChart) lineChart.destroy();

        lineChart = new Chart(ctxLine, {
          type: 'line',
          data: {
            labels: labelsFechas,
            datasets: [{
              label: 'Peso Máximo (kg)',
              data: dataPesos,
              borderColor: '#10b981',
              backgroundColor: 'rgba(16, 185, 129, 0.1)',
              borderWidth: 2,
              fill: true,
              tension: 0.2,
              pointRadius: 4,
              pointBackgroundColor: '#10b981'
            }]
          },
          options: {
            responsive: true,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: { beginAtZero: true }
            }
          }
        });
      } catch (err) {
        console.error("Error cargando gráfica de líneas:", err);
      }
    }

    // Inicializar gráfica de líneas con el primer ejercicio disponible
    cargarEvolucion();
  </script>
  <% } %>
</body>
</html>
