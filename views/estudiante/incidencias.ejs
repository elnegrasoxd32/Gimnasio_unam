<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reportar Incidencia — Gimnasio UNAM</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --accent: #4f46e5;
      --accent-dark: #3730a3;
      --accent-light: #eef2ff;
      --bg: #f1f5f9;
      --card: #ffffff;
      --nav: #0f172a;
      --text: #1e293b;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --radius: 0.875rem;
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      --success: #10b981;
      --danger: #ef4444;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── Navbar ──────────────────────────────────────────── */
    .navbar {
      background: var(--nav);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 64px;
      color: #fff;
    }

    /* ── Layout ──────────────────────────────────────────── */
    .main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .header-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .page-title {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.5rem 1rem;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--text);
      font-weight: 500;
      font-size: 0.9rem;
      transition: border-color 0.2s;
    }

    .btn-back:hover {
      border-color: var(--accent);
    }

    /* ── Alertas ─────────────────────────────────────────── */
    .alert {
      padding: 1rem;
      border-radius: 0.5rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
      font-size: 0.9rem;
    }

    .alert-error {
      background: #fee2e2;
      border: 1px solid #f87171;
      color: #b91c1c;
    }

    .alert-success {
      background: #d1fae5;
      border: 1px solid #34d399;
      color: #065f46;
    }

    /* ── Card ────────────────────────────────────────────── */
    .card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow);
      margin-bottom: 2rem;
    }

    .card-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ── Formulario ──────────────────────────────────────── */
    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    select,
    textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      font-family: inherit;
      font-size: 0.95rem;
      color: var(--text);
      background: #fff;
      transition: border-color 0.2s;
    }

    select:focus,
    textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    textarea {
      resize: vertical;
      min-height: 120px;
    }

    .char-count {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-align: right;
      margin-top: 0.3rem;
    }

    .btn-submit {
      padding: 0.7rem 1.5rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 0.5rem;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
    }

    .btn-submit:hover {
      background: var(--accent-dark);
      transform: translateY(-1px);
    }

    /* ── Tabla ───────────────────────────────────────────── */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 1rem;
      border-bottom: 1px solid var(--border);
    }

    th {
      background: #f8fafc;
      font-weight: 600;
      color: var(--text-muted);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    td {
      font-size: 0.9rem;
    }

    /* ── Badges ──────────────────────────────────────────── */
    .badge {
      display: inline-block;
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .badge-pendiente {
      background: #fef9c3;
      color: #854d0e;
      border: 1px solid #fde68a;
    }

    .badge-en_proceso {
      background: #dbeafe;
      color: #1e40af;
      border: 1px solid #bfdbfe;
    }

    .badge-resuelto {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }

    /* ── Empty state ────────────────────────────────────── */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
    }

    .empty-icon {
      font-size: 3rem;
      display: block;
      margin-bottom: 1rem;
    }

    .empty-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
    }

    .empty-desc {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 640px) {
      .main {
        padding: 1rem;
      }

      th,
      td {
        padding: 0.7rem 0.5rem;
        font-size: 0.8rem;
      }
    }
  </style>
</head>

<body>
  <nav class="navbar">
    <div style="font-weight: 700;">🏋️ Gimnasio UNAM</div>
    <div>
      <%= usuario.nombres %> (Estudiante)
    </div>
  </nav>

  <main class="main">
    <div class="header-actions">
      <h1 class="page-title">⚠️ Reportar Incidencia</h1>
      <a href="/dashboard/estudiante" class="btn-back">← Volver al Dashboard</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">⚠️ <%= error %>
      </div>
      <% } %>
        <% if (success) { %>
          <div class="alert alert-success">✅ <%= success %>
          </div>
          <% } %>

            <!-- ── Formulario ──────────────────────────────────── -->
            <div class="card">
              <h2 class="card-title">📝 Nueva Incidencia</h2>
              <form action="/estudiante/incidencias" method="POST">
                <div class="form-group">
                  <label class="form-label" for="id_tipo">Tipo de Incidencia</label>
                  <select name="id_tipo" id="id_tipo" required>
                    <option value="">— Selecciona un tipo —</option>
                    <% tipos.forEach(t=> { %>
                      <option value="<%= t.id_tipo %>">
                        <%= t.nombre %>
                      </option>
                      <% }) %>
                  </select>
                </div>

                <div class="form-group">
                  <label class="form-label" for="descripcion">Descripción</label>
                  <textarea name="descripcion" id="descripcion"
                    placeholder="Describe la incidencia con el mayor detalle posible (mín. 15, máx. 500 caracteres)..."
                    minlength="15" maxlength="500" required></textarea>
                  <div class="char-count"><span id="charCount">0</span> / 500</div>
                </div>

                <button type="submit" class="btn-submit">Enviar Reporte</button>
              </form>
            </div>

            <!-- ── Historial ───────────────────────────────────── -->
            <div class="card">
              <h2 class="card-title">📋 Mis Incidencias</h2>

              <% if (incidencias && incidencias.length> 0) { %>
                <div style="overflow-x: auto;">
                  <table>
                    <thead>
                      <tr>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% incidencias.forEach(inc=> { %>
                        <tr>
                          <td style="font-weight: 600;">
                            <%= inc.tipo %>
                          </td>
                          <td style="max-width: 320px; white-space: pre-wrap; word-break: break-word;">
                            <%= inc.descripcion %>
                          </td>
                          <td>
                            <% if (inc.estado==='PENDIENTE' ) { %>
                              <span class="badge badge-pendiente">Pendiente</span>
                              <% } else if (inc.estado==='EN_PROCESO' ) { %>
                                <span class="badge badge-en_proceso">En Proceso</span>
                                <% } else { %>
                                  <span class="badge badge-resuelto">Resuelto</span>
                                  <% } %>
                          </td>
                          <td style="white-space: nowrap;">
                            <%= new Date(inc.fecha_reporte).toLocaleDateString('es-MX', { year: 'numeric' ,
                              month: 'short' , day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                  </table>
                </div>
                <% } else { %>
                  <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <h3 class="empty-title">Sin Incidencias</h3>
                    <p class="empty-desc">Aún no has reportado ninguna incidencia. Usa el formulario de arriba si
                      necesitas informar algún problema.</p>
                  </div>
                  <% } %>
            </div>
  </main>

  <script>
    const textarea = document.getElementById('descripcion');
    const counter = document.getElementById('charCount');
    textarea.addEventListener('input', () => { counter.textContent = textarea.value.length; });
  </script>
</body>

</html>